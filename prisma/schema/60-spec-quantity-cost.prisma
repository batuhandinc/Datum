// =============================================================================
// Spesifikasyon, Metraj, Maliyet, Süreç, Fizibilite
// etut-veri-modeli.md bölüm 10, 11 ve bölüm 2 hiyerarşisi
//
// KAPSAM NOTU: Bu dosyadaki varlıkların ÇOĞU İP-1'de yalnızca şemadadır.
// Davranış kendi iş paketlerinde gelir (İP-5 metraj · İP-6 maliyet ve süreç ·
// İP-7 fizibilite). Alan tablosu olmayanlar minimal stub'tır — uydurma alan yok.
// =============================================================================

/// Proje spesifikasyon seti (:92). Bölüm 11 PAKETİ tarif ediyor ama bu
/// PROJE tarafındaki varlığa alan tablosu vermiyor → minimal stub.
/// Bölüm 11 (:562) sistemin "paket varsayılanı" ile "değiştirilmiş" alanları
/// ayırt etmesini istiyor — bu, hesaplanan/ezme üçlüsünün ta kendisidir.
model SpecificationSet {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// @tier K1 @own M @src etut-veri-modeli.md:562 — K1'de tek seçim yapılır
  selectedLevel SpecificationLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("specification_set")
}

/// Metraj (:94). Bölüm 2'de adı geçiyor, alan tablosu YOK → minimal stub.
model QuantityTakeoff {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  lines QuantityLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("quantity_takeoff")
}

/// Metraj satırı (:534). Alan adları dokümandan BİREBİR.
/// IFC: IfcPhysicalSimpleQuantity.
///
/// ŞEFFAFLIK İLKESİ (:536): her miktar hangi nesneden, hangi formülle çıktığını gösterir.
/// KAYNAK İZLENEBİLİRLİĞİ BURADA YAŞAR — entity kolonlarında değil.
///
/// AÇIK KARAR: bu varlık `isOverridden` + `overrideReason` kullanıyor; bölüm 1.3 ise
/// `computedValue` / `overrideValue` / `overrideReason` üçlüsünü tanımlıyor. Dokümanda
/// İKİ FARKLI EZME ŞEKLİ var. Birebir korundu; uzlaştırma İP-5'e bırakıldı —
/// şimdi kolon eklemek, açıkça ertelenmiş bir kararı sessizce vermek olurdu.
model QuantityLine {
  id                String          @id @default(cuid())
  quantityTakeoffId String
  quantityTakeoff   QuantityTakeoff @relation(fields: [quantityTakeoffId], references: [id], onDelete: Cascade)

  /// @src etut-veri-modeli.md:534 — CostItemCatalog.costItemCode'a mantıksal referans
  costItemCode String
  /// @src etut-veri-modeli.md:534
  description  String?
  /// @src etut-veri-modeli.md:534
  quantity     Decimal @db.Decimal(18, 4)
  /// @src etut-veri-modeli.md:534
  unit         String

  /// @src etut-veri-modeli.md:534 — hangi nesneden geldi.
  /// Polimorfik referans: FK bütünlüğü YOK (dokümanın seçtiği şekil).
  sourceObjectType String?
  sourceObjectId   String?
  /// @src etut-veri-modeli.md:534 — hangi formülle çıktı.
  /// Geometri seviyesi (G1/G2/G3) ve kullanılan katsayı bilgisi de burada yaşar.
  formula          String?

  /// @src etut-veri-modeli.md:534
  isOverridden   Boolean @default(false)
  /// @src etut-veri-modeli.md:534
  overrideReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quantityTakeoffId])
  @@index([costItemCode])
  @@index([sourceObjectType, sourceObjectId])
  @@map("quantity_line")
}

/// Maliyet tahmini (:95). Alan tablosu YOK → minimal stub. İP-6.
model CostEstimate {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  lines CostLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("cost_estimate")
}

/// Maliyet satırı (:95). Alan tablosu YOK → minimal stub. İP-6.
/// IFC: IfcCostItem.
model CostLine {
  id             String       @id @default(cuid())
  costEstimateId String
  costEstimate   CostEstimate @relation(fields: [costEstimateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([costEstimateId])
  @@map("cost_line")
}

/// Süreç örneği (:93). Alan tablosu YOK → minimal stub. İP-6.
/// IFC: IfcWorkPlan. İlke 9: süre bağlı maliyetler bu adımlardan doğar, elle girilmez.
model ProcessInstance {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Hangi ProcessTemplate'ten üretildi (paket verisi, dondurulmuş sürümden).
  processTemplateRuleKey String?

  stages Stage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("process_instance")
}

/// Aşama (:93). Alan tablosu YOK → minimal stub. İP-6. IFC: IfcTask.
model Stage {
  id                String          @id @default(cuid())
  processInstanceId String
  processInstance   ProcessInstance @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)

  steps Step[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processInstanceId])
  @@map("stage")
}

/// Adım (:93). Alan tablosu YOK → minimal stub. İP-6. IFC: IfcTask.
model Step {
  id      String @id @default(cuid())
  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@map("step")
}

/// Fiyat kütüphanesi sürümü — İP-6'da dolacak STUB.
///
/// NEDEN ŞİMDİ EKLENDİ: maliyet hesabı baştan SÜRÜM-BAZLI yazılsın diye.
/// Fiyatı bir tarihe bağlamak dondurmaz — geri tarihli bir fiyat satırı
/// eklenirse altı aylık bir projenin fiyatı değişir; etut-veri-modeli.md:28'in
/// ("Teklif verdiğin bir proje altı ay sonra farklı rakam göstermemeli")
/// tam olarak yasakladığı şey. Dondurulan şey bir SÜRÜM olmalı, bir tarih değil.
///
/// KÖK VARLIK: organizationId taşır. Fiyat kütüphanesi bölge paketinde DEĞİLDİR —
/// bölge paketi yerel MEVZUATTIR, fiyat ise piyasa verisidir ve elle girilir
/// (etut-portali-proje-dokumani.md §10.5). Bu yüzden ayrı bir dondurma eksenidir.
///
/// İP-6'da eklenecekler: PriceListEntry (kalem kodu, tarih, birim fiyat),
/// eskime uyarısı (§10.5: "45 gün önce girilmiş, teyit edin"), toplu güncelleme.
model PriceListVersion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  publishedAt DateTime?
  status      PriceListVersionStatus @default(draft)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@map("price_list_version")
}

/// Fizibilite sonucu (:96). Alan tablosu YOK → minimal stub. İP-7.
model FeasibilityResult {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feasibility_result")
}
