// =============================================================================
// Datum — Etüt ve fizibilite otomasyonu
// Şema kaynağı: etut-veri-modeli.md (sürüm 1.1) — OTORİTER
//
// KURAL: Alan adları ve enum değerleri dokümandaki isimlerle BİREBİR AYNIDIR.
//        Bir alanı "iyileştirme", yeniden adlandırma, çoğullaştırma yok.
//        Dokümanda olmayan alan uydurulmaz.
//
// AÇIKLAMA SÖZDİZİMİ:  /// @tier <K1|K2|K3|unspecified> @own <M|B|H|P|E> @src <dosya:satır>
//        @tier  — sihirbaz kademesi (bölüm 1.4). Yalnızca GÖRÜNÜRLÜK kapatır,
//                 asla NOT NULL üretmez: kademe yükseltince veri korunur.
//        @own   — veri sahipliği (etut-surec-modeli.md:42)
//                 M=manuel · B=belge · H=sistem hesaplar · P=paketten · E=dış servis
//        @src   — dokümandaki kaynak satır
//
// HESAPLANAN ALANLAR: <alan>ComputedValue / <alan>OverrideValue /
//        <alan>OverrideReason / <alan>  — sonuncusu Postgres GENERATED ALWAYS AS
//        (COALESCE(override, computed)) STORED kolonudur ve YAZILAMAZ.
//        Generated kolonlar migration SQL'inde tanımlanır (Prisma bunları
//        bildiremez), bu yüzden burada sıradan nullable kolon olarak görünürler.
//        prisma/computed-fields.ts tek doğruluk kaynağıdır; bir test dört
//        kolonun da var olduğunu doğrular.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================== Kademe ve sahiplik ==============================

/// Etüt kademesi (bölüm 1.4, :46). Sıralı: K1 < K2 < K3, görünürlük kümülatif.
enum Tier {
  K1
  K2
  K3
}

/// Bölge paketi sürüm durumu. published olan satırlar DEĞİŞMEZDİR (ilke 2).
enum RegionPackageVersionStatus {
  draft
