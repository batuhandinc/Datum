// =============================================================================
// Proje ve Parsel — etut-veri-modeli.md bölüm 3
// =============================================================================

/// Bir etüdün kök varlığı (:105-114). organizationId taşıyan iki kök varlıktan biri.
model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// @tier K1 @own M @src etut-veri-modeli.md:107
  name        String
  /// @tier K1 @own M @src etut-veri-modeli.md:108
  projectType ProjectType
  /// @tier K1 @own M @src etut-veri-modeli.md:109
  status      ProjectStatus @default(taslak)

  /// @tier K1 @own M @src etut-veri-modeli.md:110
  /// @default YOK — süreç modeli :351 sihirbazın ilk ekranında kademeyi
  /// AÇIKÇA sorduruyor ("ad, tip, kademe seçimi"). Varsayılan koymak,
  /// dokümanın vermediği bir kararı uydurmak olurdu.
  tier Tier

  /// @tier K1 @own M @src etut-veri-modeli.md:111 — DONDURULMUŞ SÜRÜM (ilke 2).
  /// SET-ONCE: null→değer serbest; değer→değer YALNIZCA aynı transaction'da
  /// `applied` bir ProjectPackageMigration varsa. Trigger ile zorlanır.
  /// Nullable, çünkü "bitti sayılır" ölçütü üç ayrı adım: proje açılır,
  /// pakete bağlanır, sürüm donar (mvp-spesifikasyonu.md:47).
  regionPackageVersionId String?
  regionPackageVersion   RegionPackageVersion? @relation(fields: [regionPackageVersionId], references: [id], onDelete: Restrict)

  /// @tier K1 @own P @src etut-veri-modeli.md:112 — "paketten gelir, ezilebilir".
  /// Paket varsayılanı bağlanma anında currencyComputedValue'ya materyalize edilir.
  currencyComputedValue  String?
  currencyOverrideValue  String?
  currencyOverrideReason String?
  /// GENERATED ALWAYS AS (COALESCE(currencyOverrideValue, currencyComputedValue)) STORED
  currency               String?

  /// @tier K1 @own M @src etut-veri-modeli.md:113 — fiyatların referans tarihi.
  /// İP-6'da priceListVersionId ile DEĞİŞTİRİLECEK. Bir tarih sürüm dondurmaz:
  /// geri tarihli bir fiyat satırı eklenirse bu projenin fiyatı değişir —
  /// :28'in yasakladığı şey. Alan şimdilik korunuyor (doküman tanımlıyor).
  priceReferenceDate DateTime? @db.Date

  /// Dondurulmuş fiyat kütüphanesi sürümü — bölge paketinden AYRI eksen.
  /// İP-6'da doldurulacak; şimdi ekleniyor ki maliyet hesabı baştan
  /// sürüm-bazlı yazılsın. Nullable: mevcut projeler bağlı değil.
  priceListVersionId String?
  priceListVersion   PriceListVersion? @relation(fields: [priceListVersionId], references: [id], onDelete: Restrict)

  /// @tier — @own M @src etut-veri-modeli.md:114 (Kademe hücresi literal "—")
  notes String?

  parcel            Parcel?
  stakeholders      Stakeholder[]
  blocks            Block[]
  unitTypes         UnitType[]
  parkingLayout     ParkingLayout?
  landscape         Landscape?
  specificationSet  SpecificationSet?
  processInstance   ProcessInstance?
  quantityTakeoffs  QuantityTakeoff[]
  costEstimates     CostEstimate[]
  feasibilityResult FeasibilityResult?
  packageMigrations ProjectPackageMigration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, tier])
  @@index([regionPackageVersionId])
  @@index([priceListVersionId])
  @@map("project")
}

/// Parselin kimliği, mülkiyeti, takyidatı (:118-131). IFC: IfcSite.
model Parcel {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// @tier K1 @own M @src etut-veri-modeli.md:120
  province     String?
  /// @tier K1 @own M @src etut-veri-modeli.md:120
  district     String?
  /// @tier K1 @own M @src etut-veri-modeli.md:120
  neighborhood String?

  /// @tier K1 @own M @src etut-veri-modeli.md:121 — ada
  block     String?
  /// @tier K1 @own M @src etut-veri-modeli.md:121
  parcelNo  String?
  /// @tier K1 @own M @src etut-veri-modeli.md:121 — pafta
  sheetNo   String?

  /// @tier K1 @own M/B @src etut-veri-modeli.md:122
  area     Decimal? @db.Decimal(12, 2)
  /// @tier K2 @own B @src etut-veri-modeli.md:123 — sınır poligonu, GeoJSON.
  /// PostGIS kullanılmıyor; poligon işlemleri Node tarafında.
  geometry Json?

  /// @tier K1 @own M @src etut-veri-modeli.md:124
  ownershipType OwnershipType?
  /// @tier K1 @own M @src etut-veri-modeli.md:125
  ownerCount    Int?

  /// @tier K2 @own M/B @src etut-veri-modeli.md:126 — şerh, ipotek, haciz, irtifak.
  /// Her kayıt: tip + açıklama + engel mi.
  encumbrances Json?

  /// @tier K1 @own M @src etut-veri-modeli.md:127
  hasExistingBuilding Boolean @default(false)

  /// @tier K1 @own M @src etut-veri-modeli.md:128
  /// BELİRSİZLİK: doküman "existingBuildingAge / floors / unitCount" yazıyor.
  /// Ortak önek "existingBuilding" olarak okundu; doküman netleştirilirse düzeltilir.
  existingBuildingAge       Int?
  existingBuildingFloors    Int?
  existingBuildingUnitCount Int?

  /// @tier K2 @own M @src etut-veri-modeli.md:129
  existingTotalArea Decimal? @db.Decimal(12, 2)
  /// @tier K1 @own M @src etut-veri-modeli.md:130
  demolitionRequired Boolean @default(false)
  /// @tier K2 @own M @src etut-veri-modeli.md:131
  structuralAssessmentStatus StructuralAssessmentStatus?

  zoningData ZoningData?
  soilData   SoilData?
  siteData   SiteData?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parcel")
}

/// İmar durumu (:135-158). Etüdün en belirleyici verisi.
model ZoningData {
  id       String @id @default(cuid())
  parcelId String @unique
  parcel   Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  /// @tier K2 @own B @src etut-veri-modeli.md:137 — imar durum belgesi
  documentFile String?
  /// @tier K2 @own B/M @src etut-veri-modeli.md:138
  planNotes    String?

  /// @tier K1 @own M @src etut-veri-modeli.md:139
  buildingOrder BuildingOrder?
  /// @tier K1 @own M @src etut-veri-modeli.md:140 — taban alanı katsayısı (TAKS)
  groundCoverageRatio Decimal? @db.Decimal(6, 4)
  /// @tier K1 @own M @src etut-veri-modeli.md:141 — emsal (KAKS)
  floorAreaRatio      Decimal? @db.Decimal(6, 4)
  /// @tier K1 @own P @src etut-veri-modeli.md:142 — paketten (ZoningRuleSet)
  farCalculationBasis FarCalculationBasis?

  /// @tier K1 @own M @src etut-veri-modeli.md:143 — çekme mesafeleri
  setbackFront Decimal? @db.Decimal(6, 2)
  setbackSide  Decimal? @db.Decimal(6, 2)
  setbackRear  Decimal? @db.Decimal(6, 2)

  /// @tier K1 @own M @src etut-veri-modeli.md:144
  maxFloorCount Int?
  /// @tier K1 @own M @src etut-veri-modeli.md:145
  maxHeight     Decimal? @db.Decimal(6, 2)
  /// @tier K2 @own P @src etut-veri-modeli.md:146 — paketten (ZoningRuleSet)
  heightReferenceMethod HeightReferenceMethod?

  /// @tier K2 @own M @src etut-veri-modeli.md:147 — cephe no, yol adı, genişlik
  roadFrontages Json?
  /// @tier K2 @own M @src etut-veri-modeli.md:148 — referans kot
  referenceLevel Decimal? @db.Decimal(8, 3)
  /// @tier K3 @own M/E @src etut-veri-modeli.md:149 — köşe kotları
  cornerLevels   Json?
  /// @tier K2 @own M @src etut-veri-modeli.md:150
  levelDataSource LevelDataSource?

  /// @tier K2 @own M @src etut-veri-modeli.md:151 — kullanıcının işaretlediği kısıtlar.
  /// Kontrol listesinin TANIMI SpecialConstraintCatalog'da (paket verisi, ilke 1).
  specialConstraints Json?

  // --- Hesaplananlar (:158) ---

  /// @own H @src etut-veri-modeli.md:158 — azami taban alanı.
  /// Türetme: parsel alanı × groundCoverageRatio, çekme mesafesi ötelemesiyle sınırlı.
  maxFootprintComputedValue  Decimal? @db.Decimal(14, 3)
  maxFootprintOverrideValue  Decimal? @db.Decimal(14, 3)
  maxFootprintOverrideReason String?
  /// GENERATED
  maxFootprint               Decimal? @db.Decimal(14, 3)

  /// @own H @src etut-veri-modeli.md:158 — azami toplam inşaat alanı.
  /// Türetme: parsel alanı × floorAreaRatio; farCalculationBasis'e göre brüt/net.
  maxTotalFloorAreaComputedValue  Decimal? @db.Decimal(14, 3)
  maxTotalFloorAreaOverrideValue  Decimal? @db.Decimal(14, 3)
  maxTotalFloorAreaOverrideReason String?
  /// GENERATED
  maxTotalFloorArea               Decimal? @db.Decimal(14, 3)

  /// @own H @src etut-veri-modeli.md:158 — yapılaşabilir zarf (GeoJSON poligon).
  /// Türetme: parsel poligonu → çekme mesafesi ötelemesi → kat adedi.
  /// Hesaplanan bir GEOMETRİDİR, sayı değil — üçlü mekanizması bunu da taşır.
  buildableEnvelopeComputedValue  Json?
  buildableEnvelopeOverrideValue  Json?
  buildableEnvelopeOverrideReason String?
  /// GENERATED
  buildableEnvelope               Json?

  /// @own H @src etut-veri-modeli.md:158 — kot farkına göre kazanılabilir bodrum.
  basementGainFromLevelDifferenceComputedValue  Decimal? @db.Decimal(14, 3)
  basementGainFromLevelDifferenceOverrideValue  Decimal? @db.Decimal(14, 3)
  basementGainFromLevelDifferenceOverrideReason String?
  /// GENERATED
  basementGainFromLevelDifference               Decimal? @db.Decimal(14, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("zoning_data")
}

/// Zemin etüdü (:162-172). Maliyetteki en büyük sürprizlerin kaynağı.
model SoilData {
  id       String @id @default(cuid())
  parcelId String @unique
  parcel   Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  /// @tier K3 @own B @src etut-veri-modeli.md:164
  reportFile        String?
  /// @tier K2 @own M @src etut-veri-modeli.md:165
  soilClass         String?
  /// @tier K3 @own M @src etut-veri-modeli.md:166 — zemin emniyet gerilmesi
  bearingCapacity   Decimal? @db.Decimal(10, 3)
  /// @tier K2 @own M @src etut-veri-modeli.md:167 — yeraltı su seviyesi
  groundwaterLevel  Decimal? @db.Decimal(8, 3)
  /// @tier K3 @own M @src etut-veri-modeli.md:168
  liquefactionRisk  LiquefactionRisk?
  /// @tier K2 @own M @src etut-veri-modeli.md:169
  foundationType    FoundationType?

  /// @tier K2-K3 @own M @src etut-veri-modeli.md:170 — Tip hücresi literal "—"
  pileRequired Boolean?
  pileCount    Int?
  pileDepth    Decimal? @db.Decimal(8, 3)
  pileDiameter Decimal? @db.Decimal(8, 3)

  /// @tier K2 @own M @src etut-veri-modeli.md:171 — Tip hücresi literal "—".
  /// NOT: süreç modeli :126 shoringArea'yı (H) sayıyor; veri modeli K2 (manuel) diyor.
  /// Veri modeli otoriter kabul edildi.
  shoringRequired Boolean?
  shoringMethod   String?
  shoringArea     Decimal? @db.Decimal(12, 3)

  /// @tier K2 @own M @src etut-veri-modeli.md:172
  adjacentBuildingDistances Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("soil_data")
}

/// Saha ve şantiye verisi (:176-185).
model SiteData {
  id       String @id @default(cuid())
  parcelId String @unique
  parcel   Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  /// @tier K2 @own M @src etut-veri-modeli.md:178 — topografya, kot farkı
  topographyLevelDifference Decimal? @db.Decimal(8, 3)
  /// @tier K2 @own M @src etut-veri-modeli.md:179 — hafriyat çıkış mesafesi (km)
  excavationHaulDistance    Decimal? @db.Decimal(8, 2)
  /// @tier K2 @own M @src etut-veri-modeli.md:180 — döküm sahası bedeli
  disposalSiteFee           Decimal? @db.Decimal(14, 2)
  /// @tier K2 @own M @src etut-veri-modeli.md:181
  siteAccessRoadWidth       Decimal? @db.Decimal(6, 2)
  /// @tier K2 @own M @src etut-veri-modeli.md:182 — vinç kurulabilirliği
  craneFeasible             Boolean?
  /// @tier K3 @own M @src etut-veri-modeli.md:183 — elektrik/su/gaz/kanal: mesafe, durum
  utilityConnections        Json?
  /// @tier K2 @own M @src etut-veri-modeli.md:184
  siteFencePerimeter        Decimal? @db.Decimal(10, 2)
  /// @tier K2 @own M @src etut-veri-modeli.md:185
  fencedSides               Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_data")
}

/// Hak sahibi (bölüm 3, sürüm 1.1'de eklendi). Alanlar A4'ten türetildi.
/// SAPMA: İngilizce tanımlayıcılar önerilmiştir — veri modelinde önceden tanımlı değildi.
model Stakeholder {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// @tier K2 @own M @src etut-surec-modeli.md:142
  name         String
  /// @tier K2 @own M @src etut-surec-modeli.md:142
  contactPhone String?
  contactEmail String?

  /// @tier K2 @own M @src etut-surec-modeli.md:143 — pay oranı
  shareRatio       Decimal? @db.Decimal(9, 6)
  /// @tier K2 @own M @src etut-surec-modeli.md:144
  existingUnitArea Decimal? @db.Decimal(12, 2)
  /// @tier K2 @own M @src etut-surec-modeli.md:145
  expectationNotes String?
  /// @tier K2 @own M @src etut-surec-modeli.md:146
  agreementStance  AgreementStance?

  /// @tier K3 @own M @src etut-surec-modeli.md:148 — geçici barınma yardımı
  housingAidEligible Boolean?
  housingAidMonths   Int?
  /// @tier K3 @own M/P @src etut-surec-modeli.md:149
  incentiveProgramEligible Boolean?

  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("stakeholder")
}
