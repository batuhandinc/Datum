// ============================================================================
// Bölüm 12.3 — Sürüm 1.1'de eklenen tablolar
// Gerekçe: dokümanın kendi formüllerindeki katsayıların evi yoktu; ev
// verilmeseydi koda gömüleceklerdi (ilke 1 ihlali).
// ============================================================================

/// Bölüm 10.1 — nesne → imalat kalemi eşlemesi.
/// Alan adları dokümandan birebir (:495).
/// Bölüm 12'de listelenmemişti; kalem kodu ve formül taşıdığı için sürüme bağlandı.
model ObjectCostMapping {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§10
  objectType      String
  /// @own P @src etut-veri-modeli.md§10
  objectVariant   String?
  /// @own P @src etut-veri-modeli.md§10 — CostItemCatalog.costItemCode'a mantıksal referans
  costItemCode    String
  /// @own P @src etut-veri-modeli.md§10 — miktar formülü.
  /// Formüldeki tüm katsayılar (0,2 dönüş payı, 0,2 torba…) BURADA yaşar, kodda değil.
  quantityFormula String
  /// @own P @src etut-veri-modeli.md§10
  conditions      Json?

  @@unique([regionPackageVersionId, ruleKey])
  @@index([regionPackageVersionId, objectType])
  @@map("object_cost_mapping")
}

/// Bölüm 1.5 (:54) — G1 çevre tahmini şekil faktörü: `çevre ≈ k × √alan`, "k tipe göre".
/// Paket satırı yoksa resolver UYARI üretir ve perimeter'ı null bırakır —
/// koda düşen bir varsayılan ilke 1'i ihlal ederdi.
model SpaceShapeFactorRule {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§4 — hangi mekan tipi
  spaceType   SpaceType
  /// @own P @src etut-veri-modeli.md§12 — k katsayısı (dikdörtgen ≈ 4,2)
  shapeFactor Decimal   @db.Decimal(8, 4)

  @@unique([regionPackageVersionId, ruleKey])
  @@unique([regionPackageVersionId, spaceType])
  @@map("space_shape_factor_rule")
}

/// Bölüm 7 servis mekanı formüllerinin "paket katsayısı" dediği ama tanımlamadığı değerler.
model UtilityCoefficientSet {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§12 — bağımsız bölüm başına talep gücü (kW)
  demandPowerPerUnit         Decimal? @db.Decimal(10, 4)
  /// @own P @src etut-veri-modeli.md§12 — ortak alan güç yoğunluğu (kW/m²)
  demandPowerPerCommonArea   Decimal? @db.Decimal(10, 6)
  /// @own P @src etut-veri-modeli.md§12 — trafo gereklilik eşiği (kW)
  transformerPowerThreshold  Decimal? @db.Decimal(10, 2)
  /// @own P @src etut-veri-modeli.md§12 — bağımsız bölüm başına kişi
  personsPerUnit             Decimal? @db.Decimal(8, 3)
  /// @own P @src etut-veri-modeli.md§12 — kişi başına günlük litre
  litresPerPerson            Decimal? @db.Decimal(8, 2)
  /// @own P @src etut-veri-modeli.md§12 — jeneratör boyutlandırma katsayısı
  generatorSizingFactor      Decimal? @db.Decimal(8, 4)
  /// @own P @src etut-veri-modeli.md§12 — ısı kaybı katsayısı (kcal/m²)
  heatLossPerArea            Decimal? @db.Decimal(10, 3)
  /// @own P @src etut-veri-modeli.md§12 — sığınak: m² başına gaz sızdırmaz kapı
  shelterAreaPerGasProofDoor Decimal? @db.Decimal(10, 3)
  /// @own P @src etut-veri-modeli.md§12 — sığınak: kişi başına m²
  shelterAreaPerPerson       Decimal? @db.Decimal(8, 3)
  /// @own P @src etut-veri-modeli.md§12 — sığınak: bağımsız bölüm başına kapasite katsayısı
  shelterPersonsPerUnit      Decimal? @db.Decimal(8, 3)

  @@unique([regionPackageVersionId, ruleKey])
  @@map("utility_coefficient_set")
}

/// Bölüm 3 (:153-154) — 11 maddelik özel kısıt kontrol listesinin TANIMI.
/// Doküman "paket tanımlı, kullanıcı işaretler" diyor ama listenin evini söylemiyor.
/// ZoningData.specialConstraints kullanıcının işaretlediği SONUÇTUR, tanım burasıdır.
model SpecialConstraintCatalog {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§12-192 — i18n anahtarı (Türkçe metin KODA GÖMÜLMEZ)
  labelKey   String
  /// @own P @src etut-veri-modeli.md§12 — projeyi bitiren bir kısıt mı
  isBlocking Boolean @default(false)
  sortOrder  Int     @default(0)

  /// @own P @src etut-veri-modeli.md — bölüm 12.4 (1.2'de eklendi).
  /// Katalog etkinin ŞEKLİNİ bildirir; DEĞER parsele özeldir ve
  /// ZoningData.specialConstraints[].value içinde durur.
  /// Örnek: maniaKotu → (maxHeight, cap); kullanıcı 47,5 girer → maxHeight 47,5 ile sınırlanır.
  /// 1.1'de bu alanlar yoktu: kullanıcı işaretliyor ama L0'a hiçbir etkisi olmuyordu.
  effectTarget ConstraintEffectTarget @default(none)
  effectKind   ConstraintEffectKind   @default(none)

  @@unique([regionPackageVersionId, ruleKey])
  @@map("special_constraint_catalog")
}

/// Bölüm 9 (:479) — cephe malzeme tipleri. Bölgeye göre değişir, kod enum'u değildir.
model FacadeMaterialCatalog {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§12 — i18n anahtarı
  labelKey     String
  /// @own P @src etut-veri-modeli.md§10 — CostItemCatalog.costItemCode'a mantıksal referans
  costItemCode String?

  facadeMaterials FacadeMaterial[]

  @@unique([regionPackageVersionId, ruleKey])
  @@map("facade_material_catalog")
}

/// Bölüm 4 (:199, :221-229) — spaceType → category eşlemesi.
/// Space.category hesaplanan bir alandır ve tipten türer; eşleme veridir.
/// VARSAYILAN EVRENSELDİR: isRegionOverride=false satırları evrensel varsayılandır,
/// bölge paketi yalnızca isRegionOverride=true satırıyla EZER.
model SpaceTypeCategoryMap {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§4-229
  spaceType        SpaceType
  /// @own P @src etut-veri-modeli.md§4-229
  category         SpaceCategory
  /// @own H @src etut-veri-modeli.md§4 — isWetArea de tipten türer
  isWetArea        Boolean       @default(false)
  /// false = evrensel varsayılan · true = bölgenin ezmesi
  isRegionOverride Boolean       @default(false)

  @@unique([regionPackageVersionId, ruleKey])
  @@unique([regionPackageVersionId, spaceType])
  @@map("space_type_category_map")
}

/// Bölüm 13 madde 4 (KAPALI KARAR) — elektrik ve mekanik metraj parametrik götürü:
/// "sürücü değişkenlere bağlı formül, SABİT TUTAR DEĞİL". Katsayılarının evi yoktu.
/// İP-10 bunları kalibre edecek.
model ParametricLumpSumRule {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§12 — disiplin: elektrik · sihhiTesisat · isitmaSogutma · havalandirma
  discipline     String
  /// @own P @src etut-veri-modeli.md§12 — sürücü değişken (ör. brüt alan, bağımsız bölüm sayısı)
  driverVariable String
  /// @own P @src etut-veri-modeli.md§10 — formül; sabit tutar YASAK
  formula        String
  /// @own P @src etut-veri-modeli.md§10 — kalibre edilebilir katsayı
  coefficient    Decimal @db.Decimal(14, 6)
  /// @own P @src etut-veri-modeli.md§10 — CostItemCatalog.costItemCode'a mantıksal referans
  costItemCode   String?

  @@unique([regionPackageVersionId, ruleKey])
  @@map("parametric_lump_sum_rule")
}

// ============================================================================
// Bölüm 12.4 — Sürüm 1.2'de eklenen tablolar
// ============================================================================

/// Yükseklik ölçüm referansı kataloğu (bölüm 12.4).
///
/// 1.1'de bu bir KOD ENUM'uydu (`HeightReferenceMethod`) ve değerleri uydurulmuştu;
/// üstelik ZoningRuleSet — yani paket verisi — onu kullanıyordu. Farklı ölçüm
/// referanslı bir bölge eklemek kod + migration gerektiriyordu: ilke 1 ihlali.
///
/// Ayrım kuralı (veri modeli 15.1): kod her üyeyi UYGULAMAK zorunda değil, yalnızca
/// SAKLIYOR ve GÖSTERİYOR → katalog tablosu.
model HeightReferenceCatalog {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P — i18n anahtarı (Türkçe metin KODA GÖMÜLMEZ)
  labelKey  String
  sortOrder Int    @default(0)

  @@unique([regionPackageVersionId, ruleKey])
  @@map("height_reference_catalog")
}

/// Paydaş anlaşma kuralları (bölüm 12.4).
///
/// `proje-dokumani`:49 paket içeriği listesinde zaten var: "Paydaş anlaşma kuralları |
/// Karar çoğunluğu eşiği, itiraz süreleri". A4'ün "karar çoğunluğu eşiği" `P` işaretli
/// ve `mvp`:53 çoğunluk göstergesini İP-2 kapsamına koyuyor — ama 1.1'de 20 tablonun
/// hiçbirinde evi yoktu. Veri modeli "RequiredSpaceRule BENZERİ bir tabloda durur"
/// diyordu; öyle bir tablo yoktu ve RequiredSpaceRule servis mekanına özeldir
/// (serviceSpaceType zorunlu).
model StakeholderConsentRule {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-surec-modeli.md§A4 — karar çoğunluğu eşiği (oran, ör. 0,6667)
  majorityThreshold   Decimal @db.Decimal(6, 4)
  /// @own P — itiraz süresi (gün). Doküman "itiraz süreleri" diyor, birim vermiyor.
  objectionPeriodDays Int?

  @@unique([regionPackageVersionId, ruleKey])
  @@map("stakeholder_consent_rule")
}

/// Birim ölçeğinde bölümleme kuralları (bölüm 12.6, sürüm 1.4).
///
/// L2 kat plakasını bölümlerken okuduğu dört değer. Hiçbiri koda gömülemez
/// (ilke 1): tolerans bir kabul eşiğidir, asgari cephe uzunluğu pencere
/// mevzuatına bağlıdır, brüt/net katsayısı ölçü geleneğidir.
model UnitLayoutRule {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§12 — brüt birim alanı ÷ net mekan alanları toplamı.
  ///
  /// NEDEN ZORUNLU: kullanıcının hedefi NET (mekan alanları toplamı), plaka BRÜT.
  /// Aradaki farkı duvar kalınlıkları, birim içi sirkülasyon payı ve ölçü
  /// alışkanlığı belirler. Katsayı BÖLMEYLE UYDURULAMAZ: `plaka ÷ Σhedef` yazmak
  /// programın plakayı tam doldurduğunu VARSAYMAK demektir ve program plakanın
  /// %60'ıysa bütün daireleri sessizce %66 şişirir. Yoksa L2 hesaplamaz + uyarı.
  grossToNetFactor    Decimal? @db.Decimal(6, 4)
  /// @own P @src etut-veri-modeli.md§12 — hedeften kabul edilen sapma oranı.
  /// `kat-plani-uretim-mimarisi.md` §9 madde 1'in açık kararı ("%3 mü %5 mi")
  /// burada kapanır: kod karar vermez, paket söyler.
  areaTolerance       Decimal? @db.Decimal(6, 4)
  /// @own P @src etut-veri-modeli.md§12 — pencere alabilmesi için asgari cephe teması (m)
  minUnitFacadeLength Decimal? @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§12 — "aşırı uzun dar birim olmasın"
  maxUnitAspectRatio  Decimal? @db.Decimal(6, 3)

  @@unique([regionPackageVersionId, ruleKey])
  @@map("unit_layout_rule")
}

/// Yapı elemanı ölçeğinde kurallar (bölüm 12.6, sürüm 1.4).
///
/// L3 ve L4'ün okuduğu değerler. Adı neden `SpaceDimensionRule` DEĞİL: duvar
/// kalınlığı ve aks aralığı bir MEKAN ölçüsü değil, bir YAPI ELEMANI ölçüsüdür;
/// "mekan boyutu" başlığı altında durmaları yanıltıcı olurdu.
///
/// Satır ya bir `spaceType` için (asgari oda ölçüleri, aydınlatma oranı) ya bir
/// `wallType` için (kalınlık) ya da bloğun tamamı için (aks aralığı) doldurulur.
model BuildingElementRule {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§12 — hangi mekan tipi için (oda kuralları)
  spaceType     SpaceType?
  /// @own P @src etut-veri-modeli.md§12 — asgari oda alanı (m²)
  minArea       Decimal?   @db.Decimal(8, 3)
  /// @own P @src etut-veri-modeli.md§12 — asgari net genişlik (m)
  minClearWidth Decimal?   @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§12 — pencere alanı ÷ taban alanı
  daylightRatio Decimal?   @db.Decimal(6, 4)

  /// @own P @src etut-veri-modeli.md§12 — hangi duvar tipi için
  wallType      WallType?
  /// @own P @src etut-veri-modeli.md§12 — duvar kalınlığı (m).
  /// Kural yoksa duvar ÜRETİLMEZ + uyarı — koda gömülü varsayılan yoktur.
  wallThickness Decimal?  @db.Decimal(6, 3)

  /// @own P @src etut-veri-modeli.md§12 — kapı ölçüsü (m).
  /// Türkiye'de asgari kapı genişliği yangın ve erişilebilirlik mevzuatıdır.
  minDoorWidth Decimal? @db.Decimal(6, 2)

  /// @own P @src etut-veri-modeli.md§12 — KABA aks aralığı (m).
  /// Gerçek statik değil: otopark verimi doğrulaması ve yapısal katsayı girdisi.
  columnSpanX Decimal? @db.Decimal(6, 2)
  columnSpanY Decimal? @db.Decimal(6, 2)

  @@unique([regionPackageVersionId, ruleKey])
  @@index([regionPackageVersionId, spaceType])
  @@map("building_element_rule")
}

/// Organizasyon seviyesinde TİPOLOJİ KÜTÜPHANESİ (bölüm 13 madde 3, sürüm 1.4).
///
/// KÖK VARLIKTIR — `organizationId` taşır ve `ORG_SCOPED_MODELS`'e girer.
///
/// NEDEN BÖLGE PAKETİNDE DEĞİL: bir tipoloji şablonu mevzuat değil, FİRMA
/// ALIŞKANLIĞIDIR — bölgeye değil, tasarımı yapana aittir. Pakete konsaydı
/// "salonu 2 m² büyüttük" yeni bir paket SÜRÜMÜ gerektirirdi ve ilke 2
/// yönetmelik değişimiyle mimari tercihi aynı kefeye koyardı.
///
/// NEDEN KOPYALANIR, REFERANS VERİLMEZ: kütüphanedeki şablonu iyileştirmek
/// BİTEN BİR PROJEYİ geriye dönük değiştirmemelidir — ilke 2'nin ruhu,
/// mevzuata değil mimari alışkanlığa uygulanmış hâli. Kopya `UnitType`'a
/// gider, kaynağı `sourceTemplateId` + `sourceTemplateVersion` ile izlenir.
model UnitTypeTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// @src etut-veri-modeli.md§13 — "3+1 A" gibi tipoloji kodu
  templateCode String
  /// @src etut-veri-modeli.md§13 — kütüphane sürümü; kopyaya yazılır
  version      String

  /// @src etut-veri-modeli.md§13 — BÖLME REÇETESİ: düğüm = kesme, yaprak = mekan.
  /// Şablon YAPIYI taşır; geometri birimin gerçek poligonuna cutByArea ile oturur.
  layoutRecipe       Json?
  /// @src etut-veri-modeli.md§13 — "salon cephe alır", "banyo şafta bitişik".
  /// KONTROL EDİLİR, ZORLANMAZ — üç durumlu tanı üretir.
  relationAssertions Json?

  units UnitType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, templateCode, version])
  @@index([organizationId])
  @@map("unit_type_template")
}
