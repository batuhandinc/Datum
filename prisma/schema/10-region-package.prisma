  /// @own P @src etut-veri-modeli.md§3 — ayrışma anahtarı: temel tipi
  foundationType FoundationType?

  /// @own P @src etut-veri-modeli.md§10 — m³/m² (kalibrasyon referansı ~0,46)
  concreteVolumePerArea Decimal @db.Decimal(10, 4)
  /// @own P @src etut-veri-modeli.md§10 — kg/m³ (kalibrasyon referansı ~85)
