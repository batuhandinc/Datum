// =============================================================================
// Kiracılık ve Bölge Paketi
// Kaynak: etut-veri-modeli.md bölüm 1.1, 1.2, 12 (sürüm 1.1)
//
// İLKE 1 — Yerel hiçbir şey koda gömülmez. Mevzuat, eşik, katsayı, kalem kodu:
//          hepsi bu tablolarda VERİDİR.
// İLKE 2 — Proje bağlandığı SÜRÜMÜ dondurur. Yayımlanmış bir sürümün satırları
//          değişmezdir; değişiklik yeni sürüm doğurur.
//
// Kural tablolarının ortak altyapı alanları (dokümanda yok, mekanizma gereği):
//   regionPackageVersionId — hangi sürüme ait
//   ruleKey                — sürümler arası KARARLI doğal anahtar. Bu olmadan
//                            iki sürüm farkı "hepsi silindi, hepsi eklendi"
//                            olarak okunur ve "farkları göster" (:30) işe yaramaz.
//   rowHash                — anlamsal içeriğin hash'i; fark hesabı tek tamsayı
//                            karşılaştırmasına iner, kozmetik değişiklik fark üretmez.
//
// SAPMA NOTU: Doküman bölüm 12 çoğu kural tablosunun İÇERİĞİNİ Türkçe tarif
// ediyor ama ALAN ADI vermiyor. Adı verilen yerlerde birebir alındı; yalnızca
// tarif edilen yerlerde `payload Json` kullanıldı — uydurma alan adı üretmemek için.
// Pilot bölge içeriği çıkarıldığında (Faz 0) bu payload'lar tiplenecek.
// =============================================================================

/// Kiracı. Tek kayıt seed edilir, arayüzde hiç görünmez (bölüm 1.1, :18).
model Organization {
  id   String @id @default(cuid())
  /// Kiracı adı — arayüzde görünmez, yalnızca yönetim içindir.
  name String

  regionPackages    RegionPackage[]
  projects          Project[]
  priceListVersions PriceListVersion[]
  unitTypeTemplates UnitTypeTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization")
}

/// Bölge paketi SOYU (bölüm 12.1). Sürüm taşımaz — sürümler ayrı varlıktır.
model RegionPackage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// @tier unspecified @own P @src etut-veri-modeli.md§3
  name      String
  /// @tier unspecified @own P @src etut-veri-modeli.md§12
  country   String
  /// @tier unspecified @own P @src etut-veri-modeli.md§12 — idari birim
  adminUnit String

  versions RegionPackageVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, country, adminUnit, name])
  @@index([organizationId])
  @@map("region_package")
}

/// Bölge paketi SÜRÜMÜ (bölüm 12.1). Projenin dondurduğu birim budur.
/// `published` olduktan sonra bu sürüme bağlı HİÇBİR kural satırı değişemez —
/// koruma migration'daki PL/pgSQL trigger'ıdır, uygulama katmanı değil.
model RegionPackageVersion {
  id              String        @id @default(cuid())
  regionPackageId String
  regionPackage   RegionPackage @relation(fields: [regionPackageId], references: [id], onDelete: Cascade)

  /// @tier unspecified @own P @src etut-veri-modeli.md§1 — sürüm no, ör. "2026.1"
  version       String
  /// @tier unspecified @own P @src etut-veri-modeli.md§12 — geçerlilik tarihi
  effectiveFrom DateTime                   @db.Date
  status        RegionPackageVersionStatus @default(draft)

  /// Yayım anı. null ise sürüm hâlâ draft.
  publishedAt  DateTime?
  /// Bu sürümün klonlandığı kaynak sürüm (yeni sürüm daima klonla açılır).
  clonedFromId String?
  clonedFrom   RegionPackageVersion?  @relation("VersionLineage", fields: [clonedFromId], references: [id])
  clones       RegionPackageVersion[] @relation("VersionLineage")

  /// Tablo bazlı içerik hash'leri. Fark hesabında kısa devre sağlar:
  /// tipik bir fark 20 tablodan 1-2'sine dokunur, gerisi sorgu bile açmaz.
  tableHashes Json?

  projects       Project[]
  migrationsFrom ProjectPackageMigration[] @relation("MigrationFrom")
  migrationsTo   ProjectPackageMigration[] @relation("MigrationTo")

  zoningRuleSets            ZoningRuleSet[]
  requiredSpaceRules        RequiredSpaceRule[]
  parkingRules              ParkingRule[]
  coreRules                 CoreRule[]
  fireSafetyRules           FireSafetyRule[]
  costItemCatalogs          CostItemCatalog[]
  costCategoryTrees         CostCategoryTree[]
  projectExpenseTemplates   ProjectExpenseTemplate[]
  specificationPackages     SpecificationPackage[]
  processTemplates          ProcessTemplate[]
  incentivePrograms         IncentiveProgram[]
  structuralCoefficientSets StructuralCoefficientSet[]
  taxAndIndexRules          TaxAndIndexRule[]
  objectCostMappings        ObjectCostMapping[]
  spaceShapeFactorRules     SpaceShapeFactorRule[]
  utilityCoefficientSets    UtilityCoefficientSet[]
  specialConstraintCatalogs SpecialConstraintCatalog[]
  facadeMaterialCatalogs    FacadeMaterialCatalog[]
  spaceTypeCategoryMaps     SpaceTypeCategoryMap[]
  parametricLumpSumRules    ParametricLumpSumRule[]
  unitLayoutRules           UnitLayoutRule[]
  buildingElementRules      BuildingElementRule[]
  heightReferenceCatalogs   HeightReferenceCatalog[]
  stakeholderConsentRules   StakeholderConsentRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regionPackageId, version])
  @@index([regionPackageId, status])
  @@map("region_package_version")
}

/// Bir projenin bir sürümden diğerine geçişi (:30 "yeni sürüme geçir").
/// Project.regionPackageVersionId set-once'tır; değer→değer değişimi YALNIZCA
/// aynı transaction'da `applied` bir bu kayıt varsa mümkündür.
model ProjectPackageMigration {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fromVersionId String
  fromVersion   RegionPackageVersion @relation("MigrationFrom", fields: [fromVersionId], references: [id])
  toVersionId   String
  toVersion     RegionPackageVersion @relation("MigrationTo", fields: [toVersionId], references: [id])

  status         PackageMigrationStatus @default(pending)
  /// Kullanıcıya gösterilen fark özeti (hangi kural değişti, hangisi bu projeye dokunuyor).
  diff           Json?
  /// Ezilmiş değerlerden hangilerinin yeniden onay beklediği.
  staleOverrides Json?

  appliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([projectId, status])
  @@map("project_package_migration")
}

// ============================================================================
// Bölüm 12.2 — Kural tabloları (dokümandaki 13 tablo)
// ============================================================================

/// :583 — emsal hesap yöntemi, yükseklik ölçüm referansı, emsal harici kurallar
model ZoningRuleSet {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§3 — emsal hesap yöntemi
  farCalculationBasis    FarCalculationBasis
  /// @own P @src etut-veri-modeli.md§3 — yükseklik ölçüm referansı.
  /// 1.2: kod enum'undan HeightReferenceCatalog anahtarına döndü (ilke 1).
  heightReferenceRuleKey String?
  /// @own P @src etut-veri-modeli.md§12 — emsal harici alan kuralları.
  /// Doküman alan adı vermiyor, yalnızca tarif ediyor. İP-2 bunları HESABA KATMAZ
  /// (emsal harici alanlar ancak program girildikten sonra, A5/İP-3'te bilinir) — uyarı üretir.
  farExemptionRules      Json?
  /// @own P @src etut-veri-modeli.md§12 — çekme ötelemesinde içbükey köşe davranışı.
  /// VARSAYILAN YOK: paket vermezse zarf hesaplanmaz, uyarı üretilir (ilke 1).
  offsetJoinType         OffsetJoinType?

  @@unique([regionPackageVersionId, ruleKey])
  @@map("zoning_rule_set")
}

/// :584 — mekan tipi, tetikleyici (bağımsız bölüm sayısı / alan / güç / yükseklik), eşik, alan formülü
model RequiredSpaceRule {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§12 — hangi servis mekanı
  serviceSpaceType ServiceSpaceType
  /// @own P @src etut-veri-modeli.md§12 — tetikleyici: unitCount · area · power · height
  triggerType      String
  /// @own P @src etut-veri-modeli.md§10 — eşik değeri
  threshold        Decimal          @db.Decimal(18, 4)
  /// @own P @src etut-veri-modeli.md§12 — alan formülü (sürücü değişkene bağlı)
  areaFormula      String?

  @@unique([regionPackageVersionId, ruleKey])
  @@map("required_space_rule")
}

/// :585 — ihtiyaç formülü, park yeri boyutları, rampa eğim sınırı, engelli oranı
model ParkingRule {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§12 — ihtiyaç formülü
  requirementFormula    String
  /// @own P @src etut-veri-modeli.md§12 — park yeri boyutları
  spaceWidth            Decimal  @db.Decimal(6, 2)
  spaceLength           Decimal  @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§8 — rampa eğim sınırı (:454 maksimumu)
  maxRampSlope          Decimal  @db.Decimal(5, 4)
  /// @own P @src etut-veri-modeli.md§12 — engelli park oranı (:444)
  accessibleRatio       Decimal  @db.Decimal(5, 4)
  /// @own P @src etut-veri-modeli.md§8 — manevra koridoru genişliği
  maneuveringAisleWidth Decimal  @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§12 — bisiklet park oranı
  bicycleRatio          Decimal? @db.Decimal(5, 4)
  /// @own P @src etut-veri-modeli.md§12 — elektrikli şarj noktası oranı/zorunlu adet
  electricChargingRatio Decimal? @db.Decimal(5, 4)

  /// @own P @src etut-veri-modeli.md§12.5 — ARAÇ BAŞINA ALAN (m²), sürüm 1.3.
  ///
  /// NEDEN spaceWidth × spaceLength YETMİYOR: o çarpım park yerinin KENDİ alanıdır,
  /// gerçek verim değil. Aradaki farkı kolon kayıpları, rampa başı ölü alanlar,
  /// sütun aralığı ve dönüş yarıçapları belirler — hiçbiri o üç değerden
  /// türetilemez ve türetilen sayı SİSTEMATİK OLARAK İYİMSER çıkar.
  ///
  /// OTORİTE BURADADIR. İP-4'te kolon aksları gelince geometrik yerleşim bu
  /// katsayıyı DEĞİŞTİRMEZ, DOĞRULAR: fiili yerleşim belirgin saparsa uyarı üretir.
  /// İP-10 geriye dönük doğrulamada kalibre edilecek kalemlerdendir.
  ///
  /// Nullable: kural yoksa sayım YAPILMAZ + uyarı. Koda gömülü varsayılan yok (ilke 1).
  areaPerSpace           Decimal? @db.Decimal(8, 3)
  accessibleAreaPerSpace Decimal? @db.Decimal(8, 3)
  bicycleAreaPerSpace    Decimal? @db.Decimal(8, 3)

  @@unique([regionPackageVersionId, ruleKey])
  @@map("parking_rule")
}

/// :586 — asansör eşikleri, minimum kabin ölçüleri, merdiven genişlikleri, kaçış mesafeleri
model CoreRule {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§12 — asansör zorunluluk eşiği (kat/yükseklik)
  elevatorRequiredFloorThreshold  Int?
  elevatorRequiredHeightThreshold Decimal? @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§12 — minimum asansör adedi
  minElevatorCount                Int?
  /// @own P @src etut-veri-modeli.md§12 — sedye asansörü zorunluluğu ve minimum kabin ölçüsü
  stretcherElevatorRequired       Boolean?
  minStretcherCabinWidth          Decimal? @db.Decimal(6, 2)
  minStretcherCabinDepth          Decimal? @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§12 — yangın asansörü eşiği
  fireElevatorHeightThreshold     Decimal? @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§12 — merdiven genişlikleri
  minStairWidth                   Decimal? @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§12 — kaçış mesafeleri
  maxEscapeDistance               Decimal? @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§12 — SİRKÜLASYON asgari genişliği (sürüm 1.3).
  ///
  /// `etut-portali-proje-dokumani.md` §5 katman 2 "Sirkülasyon alanı asgari
  /// genişlikleri"ni paket içeriği sayıyor ama CoreRule'da karşılığı yoktu.
  /// L1 çekirdeği boyutlandırırken asansör/merdiven bandının önündeki holü
  /// bu değerle ekler; olmadan çekirdek hesaplanamaz (koda gömülemez, ilke 1).
  minCirculationWidth             Decimal? @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§12 — asansör kapasitesi kg/kişi katsayısı
  /// (doküman ":332 ≈ kişi × 75" diyor; 75 KODA GÖMÜLEMEZ — ilke 1)
  elevatorKgPerPerson             Decimal? @db.Decimal(6, 2)

  @@unique([regionPackageVersionId, ruleKey])
  @@map("core_rule")
}

/// :587 — pompa/sprinkler/basınçlandırma eşikleri, yangın merdiveni şartları
model FireSafetyRule {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§12 — yangın pompası bina yüksekliği eşiği
  firePumpHeightThreshold Decimal? @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§12 — sprinkler zorunluluk eşiği
  sprinklerAreaThreshold  Decimal? @db.Decimal(12, 2)
  /// @own P @src etut-veri-modeli.md§7 — dedektör kapsama alanı (m²/dedektör)
  detectorCoverageArea    Decimal? @db.Decimal(8, 2)
  /// @own P @src etut-veri-modeli.md§12 — basınçlandırma eşiği
  pressurizationThreshold Decimal? @db.Decimal(6, 2)
  /// @own P @src etut-veri-modeli.md§7 — yangın rezerv hacmi
  fireReserveVolume       Decimal? @db.Decimal(10, 2)
  /// @own P @src etut-veri-modeli.md§12 — yangın merdiveni şartları (tarif, alan adı yok)
  fireStairRequirements   Json?

  @@unique([regionPackageVersionId, ruleKey])
  @@map("fire_safety_rule")
}

/// :588 — kalem kodu, ad, birim, kategori, açıklık düşüm kuralı
/// İLKE 6: açıklık düşümü kuralı KALEM BAZINDA merkezî tanımlıdır, burada yaşar.
model CostItemCatalog {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§10
  costItemCode              String
  /// @own P @src etut-veri-modeli.md§3
  name                      String
  /// @own P @src etut-veri-modeli.md§2
  unit                      String
  /// @own P @src etut-veri-modeli.md§4 — CostCategoryTree.ruleKey'e mantıksal referans
  category                  String
  /// @own P @src etut-veri-modeli.md§10, kural tanımı :517-522
  openingDeductionRule      OpeningDeductionRule @default(none)
  /// @own P @src etut-veri-modeli.md§12 — above_threshold kuralının eşiği (ör. 0,5 m²).
  /// Doküman eşiğe alan adı vermiyor; KODA GÖMÜLEMEZ olduğu için burada.
  openingDeductionThreshold Decimal?             @db.Decimal(8, 3)

  @@unique([regionPackageVersionId, ruleKey])
  @@unique([regionPackageVersionId, costItemCode])
  @@map("cost_item_catalog")
}

/// :589 — kaba/ince/diğer kırılımı (bölgeye göre değişir)
model CostCategoryTree {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md§3
  name          String
  /// @own P @src etut-veri-modeli.md§12 — ağaç yapısı için üst kategori ruleKey'i
  parentRuleKey String?
  sortOrder     Int     @default(0)

  @@unique([regionPackageVersionId, ruleKey])
  @@map("cost_category_tree")
}

/// :590 — denetim bedeli, sigorta primi, abonelik, teminat komisyonu formülleri
model ProjectExpenseTemplate {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
