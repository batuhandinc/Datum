  formworkAreaPerVolume Decimal @db.Decimal(10, 4)
  /// @own P @src etut-veri-modeli.md§10 — kalıp işçiliği oranı (referans ~%41)
  formworkLaborRate     Decimal @db.Decimal(10, 4)

  @@unique([regionPackageVersionId, ruleKey])
  @@map("structural_coefficient_set")
}

