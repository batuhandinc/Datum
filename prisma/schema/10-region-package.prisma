  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
  rowHash                String?

  /// @own P @src etut-veri-modeli.md:528 — ayrışma anahtarı: kat adedi aralığı
  floorCountMin          Int?
  floorCountMax          Int?
  /// @own P @src etut-veri-modeli.md:528 — ayrışma anahtarı: temel tipi
  foundationType         FoundationType?

  /// @own P @src etut-veri-modeli.md:528 — m³/m² (kalibrasyon referansı ~0,46)
  concreteVolumePerArea  Decimal @db.Decimal(10, 4)
  /// @own P @src etut-veri-modeli.md:528 — kg/m³ (kalibrasyon referansı ~85)
  rebarWeightPerVolume   Decimal @db.Decimal(10, 4)
  /// @own P @src etut-veri-modeli.md:528 — m²/m³ (kalibrasyon referansı ~3,1)
