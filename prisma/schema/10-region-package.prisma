/// :594 + bölüm 10.3 — ampirik katsayılar.
/// Doküman 10.3 alan adlarını AÇIKÇA veriyor; birebir alındı.
/// Katsayılar kat adedine ve temel tipine göre ayrışır → anahtarlı koleksiyon.
model StructuralCoefficientSet {
  id                     String               @id @default(cuid())
  regionPackageVersionId String
  regionPackageVersion   RegionPackageVersion @relation(fields: [regionPackageVersionId], references: [id], onDelete: Cascade)
  ruleKey                String
