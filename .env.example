# GERÇEK POSTGRES — docker-compose.yml ile birebir eşleşir
DATABASE_URL="postgresql://datum:datum@localhost:5432/datum?schema=public"

# DOCKER YOKSA — npm run db:local (PGlite'ı 5432'de Postgres olarak sunar).
# pgbouncer=true ZORUNLU: PGlite tek oturumdur, soket sunucusu tüm bağlantıları
# onun üzerine çoğullar; adlandırılmış hazır ifadeler süreçler arasında çakışır.
# DATABASE_URL="postgresql://datum:datum@127.0.0.1:5432/datum?schema=public&pgbouncer=true&connection_limit=1"
