{
  "name": "datum",
  "version": "0.1.0",
  "private": true,
  "description": "Etüt ve fizibilite otomasyonu — İP-1 temel altyapı",
  "scripts": {
    "dev": "next dev",
    "build": "npm run codegen && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "codegen": "tsx prisma/codegen/generate.ts",
    "codegen:check": "tsx prisma/codegen/generate.ts --check",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:local": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:fixture": "tsx prisma/fixtures/load.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@tmcw/togeojson": "^7.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "clipper-lib": "^6.4.2",
    "dotenv": "^17.4.2",
    "next": "^15.1.4",
    "proj4": "^2.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/clipper-lib": "^6.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.5",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "fast-check": "^4.9.0",
    "pglite-prisma-adapter": "^0.6.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
